{
  "manifest_version": 2,
  "name": "Rastro",
  "version": "0.1.0",
  "description": "Detecta conexões a domínios de terceira parte, cookies injetados e uso de armazenamento HTML5 (localStorage, sessionStorage, IndexedDB), com pontuação de privacidade.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rastro@cyber-pi",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "webRequest",
    "webNavigation",
    "cookies",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["lib/psl.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_action": {
    "default_title": "Rastro",
    "default_popup": "popup/popup.html"
  }
}