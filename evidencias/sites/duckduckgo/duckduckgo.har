"type\":0,\"value\":\".\"}],\"Hh/K/3\":[{\"type\":0,\"value\":\"Elimina todos os separadores, histórico e dados de navegação com um clique\"}],\"Hw9cXC\":[{\"type\":0,\"value\":\"Experimentar gratuitamente\"}],\"I4JaQV\":[{\"type\":0,\"value\":\"Não são dados de treino, apenas a tua conversa.\"}],\"I4x8+4\":[{\"type\":0,\"value\":\"Bloquear rastreadores ocultos em e-mails\"}],\"I6xddi\":[{\"type\":0,\"value\":\"Elimina os dados de navegação com um botão\"}],\"IF5muG\":[{\"type\":0,\"value\":\"Bloquear pop-ups irritantes de cookies\"}],\"IKm5c/\":[{\"type\":0,\"value\":\"Bloqueia a maioria dos anúncios e pop-ups de cookies\"}],\"IQuvGD\":[{\"type\":0,\"value\":\"Raciocínio\"}],\"IcO01G\":[{\"type\":0,\"value\":\"Reproduz vídeos do YouTube sem anúncios\"}],\"IcaEo/\":[{\"type\":0,\"value\":\"Se tiveres outras ideias, gostaríamos de as ouvir!\"}],\"IwcTa1\":[{\"type\":0,\"value\":\"Importa, guarda e encripta as tuas palavras-passe.\"}],\"JfBnDI\":[{\"type\":0,\"value\":\"Se és como a maioria das pessoas na Internet, usas o Google para pesquisar na web e o Google Chrome para navegar. Isso significa que, por predefinição, o Google pode rastrear todas as pesquisas que fazes e todos os sites que visitas. Nesses sites, outras empresas também podem rastrear-te.\"}],\"JxzTE5\":[{\"type\":0,\"value\":\"Raciocínio\"}],\"K3FDPw\":[{\"type\":0,\"value\":\"Gera endereços de e-mail privados\"}],\"KNxIvR\":[{\"type\":0,\"value\":\"Ajuda\"}],\"KWYSIO\":[{\"type\":0,\"value\":\"Subscrição\"}],\"KpnRFa\":[{\"type\":0,\"value\":\"Navegador para Android\"}],\"KtTyL5\":[{\"type\":0,\"value\":\"Transferir navegador DuckDuckGo\"}],\"KucbbF\":[{\"type\":0,\"value\":\"Estendido\"}],\"L3sWv8\":[{\"type\":0,\"value\":\"Marca a opção \\\"\"},{\"type\":8,\"value\":\"Bold\",\"children\":[{\"type\":0,\"value\":\"Permitir que a extensão seja executada em janelas privadas\"}]},{\"type\":0,\"value\":\"\\\"\"}],\"LVD/vX\":[{\"type\":0,\"value\":\"Não confies apenas na nossa palavra.\"}],\"LrAIIn\":[{\"