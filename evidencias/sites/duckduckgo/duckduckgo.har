ons?\"}]})})}),(0,aF.jsx)(\"div\",{className:sh.default.faqRightCol,children:(0,aF.jsx)(\"div\",{ref:o,children:(0,aF.jsxs)(sl,{defaultExpandedKeys:new Set([\"faq-1\"]),onExpandedChange:n?function(){return n()}:void 0,children:[(0,aF.jsxs)(ss,{id:\"faq-1\",children:[(0,aF.jsx)(sy,{children:(0,aF.jsx)(aH.FormattedMessage,{id:\"cn+NYN\",defaultMessage:[{type:0,value:\"What is DuckDuckGo?\"}]})}),(0,aF.jsx)(su,{children:(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"fxJRqC\",defaultMessage:[{type:0,value:\"At DuckDuckGo, we believe the best way to protect your personal information from hackers, scammers, and privacy-invasive companies is to stop it from being collected at all. That's why millions of people \"},{children:[{type:0,value:\"choose DuckDuckGo over Chrome and other browsers\"}],type:8,value:\"privacyComparisonLink\"},{type:0,value:\" to search and browse online. Our built-in search engine is like Google but never tracks your searches, and our browser blocks ads, trackers, and cookies that collect your data. It also offers private, useful, and optional AI, including \"},{children:[{type:0,value:\"Duck.ai\"}],type:8,value:\"duckAiLink\"},{type:0,value:\", which lets you chat privately with ChatGPT, Claude, and other AIs, all in one place. Oh, and our browser is free. We make money from \"},{children:[{type:0,value:\"privacy-respecting search ads\"}],type:8,value:\"privacyRespectingAdsLink\"},{type:0,value:\", not by exploiting your data. Take back control of your personal information with the browser designed for data protection, not data collection. \"},{children:[{type:0,value:\"Learn more\"}],type:8,value:\"learnMoreLink\"}],values:{learnMoreLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/company/\"),privacyComparisonLink:sv(\"https://duckduckgo.com/compare-privacy\"),duckAiLink:sv(\"https://duck.ai\"),privacyRespectingAdsLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/company/how-duckduckgo-makes-money/\")}})})})]}),(0,aF.jsxs)(ss,{id:\"faq-2\",children:[(0,aF.jsx)(sy,{children:(0,aF.jsx)(aH.FormattedMessage,{id:\"oKvwr+\",defaultMessage:[{type:0,value:\"How does DuckDuckGo protect my privacy?\"}]})}),(0,aF.jsx)(su,{children:(0,aF.jsxs)(sp,{direction:\"column\",className:sh.default.faqAnswer,children:[(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"JfBnDI\",defaultMessage:[{type:0,value:\"If you’re like most people on the Internet, you use Google to search the web and Google Chrome to browse the web. That means, by default, Google can keep track of every single search you make and website you visit. On those websites, other companies may also track you.\"}]})}),(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"tM1aTp\",defaultMessage:[{type:0,value:\"DuckDuckGo is an independent Google alternative that also lets you search and browse the web, but we don’t track your searches or browsing history, and our \"},{children:[{type:0,value:\"browsers\"}],type:8,value:\"browsersLink\"},{type:0,value:\" and \"},{children:[{type:0,value:\"extensions\"}],type:8,value:\"extensionsLink\"},{type:0,value:\" help you block other companies from trying to track you as well, all by default. Our free browser comes with seamless protection built-in, including \"},{children:[{type:0,value:\"tracker blocking\"}],type:8,value:\"trackerBlockingLink\"},{type:0,value:\", \"},{children:[{type:0,value:\"increased encryption\"}],type:8,value:\"increasedEncryptionLink\"},{type:0,value:\", \"},{children:[{type:0,value:\"email protection\"}],type:8,value:\"emailProtectionLink\"},{type:0,value:\", and more, making it the most comprehensive protection you can get with one download. Plus, \"},{children:[{type:0,value:\"DuckDuckGo subscribers\"}],type:8,value:\"duckDuckGoSubscriptionLink\"},{type:0,value:\" get four additional features: a fast and simple \"},{children:[{type:0,value:\"VPN\"}],type:8,value:\"vpnLink\"},{type:0,value:\", access to advanced AI models in \"},{children:[{type:0,value:\"Duck.ai\"}],type:8,value:\"duckAiLink\"},{type:0,value:\", a \"},{children:[{type:0,value:\"Personal Information Removal\"}],type:8,value:\"personalInformationRemovalLink\"},{type:0,value:\" service, and an \"},{children:[{type:0,value:\"Identity Theft Restoration\"}],type:8,value:\"identityTheftRestorationLink\"},{type:0,value:\" service. That’s how DuckDuckGo helps protect you in a nutshell. \"},{children:[{type:0,value:\"Learn more\"}],type:8,value:\"learnMoreLink\"}],values:{browsersLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/get-duckduckgo/does-duckduckgo-make-a-browser/\"),extensionsLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/desktop/adding-duckduckgo-to-your-browser/\"),trackerBlockingLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/\"),increasedEncryptionLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/#smarter-encryption-https-upgrading\"),emailProtectionLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/email-protection/what-is-duckduckgo-email-protection/\"),duckDuckGoSubscriptionLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy-pro/\"),vpnLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy-pro/vpn/\"),duckAiLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/duckai\"),personalInformationRemovalLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy-pro/personal-information-removal/\"),identityTheftRestorationLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy-pro/identity-theft-restoration/\"),learnMoreLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/company/how-does-duckduckgo-protect-privacy/\")}})})]})})]}),(0,aF.jsxs)(ss,{id:\"faq-3\",children:[(0,aF.jsx)(sy,{children:(0,aF.jsx)(aH.FormattedMessage,{id:\"ZuNLx4\",defaultMessage:[{type:0,value:\"Does DuckDuckGo block all trackers on websites I visit?\"}]})}),(0,aF.jsx)(su,{children:(0,aF.jsxs)(sp,{direction:\"column\",className:sh.default.faqAnswer,children:[(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"qUwfSi\",defaultMessage:[{type:0,value:\"DuckDuckGo \"},{children:[{type:0,value:\"never tracks you\"}],type:8,value:\"neverTracksLink\"},{type:0,value:\". And when you leave our search engine and use our browsers or extensions to visit other sites, we aim to protect your privacy as much as possible. No service can eliminate all hidden tracking or all profiling online because trackers are always trying to evade specific protections. To be effective, our protections continually evolve to mitigate this while avoiding website breakage. That’s also why we offer multiple types of \"},{children:[{type:0,value:\"web tracking protections\"}],type:8,value:\"webTrackingProtectionsLink\"},{type:0,value:\".\"}],values:{neverTracksLink:sv(\"https://duckduckgo.com/privacy\"),webTrackingProtectionsLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/\")}})}),(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"7KjPb/\",defaultMessage:[{type:0,value:\"Other browsers offer some of these by default, like cookie and fingerprinting protections, but we also provide many other protections that most browsers do not offer by default, like \"},{children:[{type:0,value:\"3rd-Party Tracker Loading Protection\"}],type:8,value:\"thirdPartyLink\"},{type:0,value:\", \"},{children:[{type:0,value:\"Global Privacy Control\"}],type:8,value:\"globalPrivacyLink\"},{type:0,value:\", \"},{children:[{type:0,value:\"Link Tracking Protection\"}],type:8,value:\"linkTrackingLink\"},{type:0,value:\", \"},{children:[{type:0,value:\"CNAME Cloaking Protection\"}],type:8,value:\"cnameCloakingLink\"},{type:0,value:\", \"},{children:[{type:0,value:\"Google AMP Protection\"}],type:8,value:\"googleAmpLink\"},{type:0,value:\", and \"},{children:[{type:0,value:\"more\"}],type:8,value:\"moreLink\"},{type:0,value:\", which all help cover different tracking angles. Our \"},{children:[{type:0,value:\"list of trackers\"}],type:8,value:\"listOfTrackersLink\"},{type:0,value:\" is open source, along with the \"},{children:[{type:0,value:\"list of exceptions\"}],type:8,value:\"listOfExceptionsLink\"},{type:0,value:\" we make to preserve usability. \"},{children:[{type:0,value:\"Learn more\"}],type:8,value:\"learnMoreLink\"}],values:{thirdPartyLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/#3rd-party-tracker-loading-protection\"),globalPrivacyLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/#global-privacy-control-gpc\"),linkTrackingLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/#link-tracking-protection\"),cnameCloakingLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/#cname-cloaking-protection\"),googleAmpLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/#google-amp-protection\"),moreLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/\"),listOfTrackersLink:sv(\"https://github.com/duckduckgo/tracker-blocklists\"),listOfExceptionsLink:sv(\"https://github.com/duckduckgo/privacy-configuration\"),learnMoreLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections\")}})})]})})]}),(0,aF.jsxs)(ss,{id:\"faq-4\",children:[(0,aF.jsx)(sy,{children:(0,aF.jsx)(aH.FormattedMessage,{id:\"h2vdnR\",defaultMessage:[{type:0,value:\"How many people use DuckDuckGo?\"}]})}),(0,aF.jsx)(su,{children:(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"XTRq0J\",defaultMessage:[{type:0,value:\"Our best guess — over 100 million people! We don’t track our users, so it’s impossible for us to know how many people in total actually use our product. However, we can make an estimate based on the number of searches we get each month. Thanks to all these users, DuckDuckGo \"},{children:[{type:0,value:\"holds the #2 position in mobile search market share\"}],type:8,value:\"marketShareReportLink\"},{type:0,value:\" in the US, and 20 other markets including the United Kingdom, Canada, Australia, Poland, Italy, and Spain.\"}],values:{marketShareReportLink:sv(\"https://duckduckgo.com/cloudflare-radar-report\")}})})})]}),(0,aF.jsxs)(ss,{id:\"faq-5\",children:[(0,aF.jsx)(sy,{children:(0,aF.jsx)(aH.FormattedMessage,{id:\"gn0Jh/\",defaultMessage:[{type:0,value:\"How does DuckDuckGo make money?\"}]})}),(0,aF.jsx)(su,{children:(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"5wG46Q\",defaultMessage:[{type:0,value:\"We make money from private ads on our search engine. On other search engines, ads are based on profiles compiled from your personal information, such as search, browsing, and purchase history. We don’t have that information (per our \"},{children:[{type:0,value:\"Privacy Policy\"}],type:8,value:\"privacyPolicyLink\"},{type:0,value:\") because search ads on DuckDuckGo are based on the search results page you’re viewing instead of on what other companies’ tracking algorithms assume about you. For example, if you search for cars, we’ll show you ads about cars. We also make money from the paid \"},{children:[{type:0,value:\"DuckDuckGo subscription\"}],type:8,value:\"duckDuckGoSubscriptionLink\"},{type:0,value:\", our four-in-one subscription service. \"},{children:[{type:0,value:\"Learn more\"}],type:8,value:\"learnMoreLink\"}],values:{learnMoreLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/company/how-duckduckgo-makes-money/\"),privacyPolicyLink:sv(\"https://duckduckgo.com/privacy\"),duckDuckGoSubscriptionLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy-pro/\")}})})})]}),(0,aF.jsxs)(ss,{id:\"faq-6\",children:[(0,aF.jsx)(sy,{children:(0,aF.jsx)(aH.FormattedMessage,{id:\"lQjUFV\",defaultMessage:[{type:0,value:\"Why use DuckDuckGo instead of Google?\"}]})}),(0,aF.jsx)(su,{children:(0,aF.jsxs)(sp,{direction:\"column\",className:sh.default.faqAnswer,children:[(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"eSGDq9\",defaultMessage:[{children:[{type:0,value:\"Use DuckDuckGo to help protect yourself online.\"}],type:8,value:\"bold\"},{type:0,value:\" Ever get ads so creepy it feels like your phone is listening to you? Or see ads for something you searched for once following you around everywhere? If you’re wondering who to blame, it’s probably Google. For decades, they’ve been tracking your searches, embedding trackers in their Chrome browser, and hiding even more trackers on the most-popular websites. This type of mass collection of your personal information can make you vulnerable to hackers, scammers, and other privacy-invasive companies.\"}],values:{bold:sm}})}),(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"NO91BD\",defaultMessage:[{type:0,value:\"DuckDuckGo lets you search and browse like you’re used to, but (unlike Google) we never track you and our browser helps block trackers from companies that run online tracking networks like Google, TikTok, and Meta (Facebook). Oh, and our browser is free — we make money from \"},{children:[{type:0,value:\"privacy-respecting search ads\"}],type:8,value:\"privacyRespectingAdsLink\"},{type:0,value:\", not by exploiting your data.\"}],values:{privacyRespectingAdsLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/company/how-duckduckgo-makes-money/\")}})}),(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"Vk9mGE\",defaultMessage:[{children:[{type:0,value:\"Use DuckDuckGo to get a better online experience.\"}],type:8,value:\"bold\"},{type:0,value:\" Have you noticed Google search results getting worse? \"},{children:[{type:0,value:\"You’re not alone\"}],type:8,value:\"youAreNotAloneLink\"},{type:0,value:\". For many Google searches, most of the results on the first page are either ads or Google pushing their own services. It can be even worse on mobile.\"}],values:{bold:sm,youAreNotAloneLink:sv(\"https://www.theatlantic.com/ideas/archive/2022/06/google-search-algorithm-internet/661325/\")}})}),(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"PBASgy\",defaultMessage:[{type:0,value:\"On DuckDuckGo, we keep ads to a minimum and our search ads are private, only based on the search results page you’re viewing, and not on you as a person. The tracker blocking that’s built in to our browser also blocks a large number of tracker-dependent ads from loading by default. Coupled with other browser features like \"},{children:[{type:0,value:\"automatically blocking cookie pop-ups\"}],type:8,value:\"blockingCookieLink\"},{type:0,value:\", our default \"},{children:[{type:0,value:\"web tracking protections\"}],type:8,value:\"webTrackingProtectionsLink\"},{type:0,value:\" give you a cleaner online experience overall with DuckDuckGo.\"}],values:{webTrackingProtectionsLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/\"),blockingCookieLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/privacy/web-tracking-protections/#cookie-pop-up-management\")}})}),(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"0yJSap\",defaultMessage:[{children:[{type:0,value:\"Use DuckDuckGo to send a message to Big Tech companies like Google who are taking away user choice online and profiting by stealing your personal information.\"}],type:8,value:\"bold\"},{type:0,value:\" Google is the epitome of Big Tech, with their tentacles in everything, compiling detailed profiles about everyone, and making billions of dollars auctioning off access to your attention, and for what? Creepy ads that follow you around? By comparison, DuckDuckGo is a small, independent company, based in Paoli, Pennsylvania, with a vision to offer a choice to be more protected online without sacrifice to anyone who wants it.\"}],values:{bold:sm}})}),(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"16Jsg8\",defaultMessage:[{type:0,value:\"Use DuckDuckGo because it’s fast and secure, because it’s a free Google alternative that lets you search and browse the way you want, and because it puts you back in control of your personal data.\"}]})})]})})]}),(0,aF.jsxs)(ss,{id:\"faq-7\",children:[(0,aF.jsx)(sy,{children:(0,aF.jsx)(aH.FormattedMessage,{id:\"1f1TBd\",defaultMessage:[{type:0,value:\"Is Incognito Mode private?\"}]})}),(0,aF.jsx)(su,{children:(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"aj2GPR\",defaultMessage:[{type:0,value:\"No. It is a myth that you can't be tracked while using so-called “Incognito” mode. In fact, all Incognito mode really does is delete information on your computer. Incognito mode does nothing to stop Google from saving your searches, nor does it stop companies, Internet service providers, or governments from being able to track you online. By contrast, DuckDuckGo Search never keeps your or anyone else's search history and the DuckDuckGo browser helps keep you protected on websites too. \"},{children:[{type:0,value:\"Learn more\"}],type:8,value:\"learnMoreLink\"}],values:{learnMoreLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/company/how-does-duckduckgo-protect-privacy/\")}})})})]}),(0,aF.jsxs)(ss,{id:\"faq-8\",children:[(0,aF.jsx)(sy,{children:(0,aF.jsx)(aH.FormattedMessage,{id:\"GkUN6W\",defaultMessage:[{type:0,value:\"How do DuckDuckGo Search results compare to Google's?\"}]})}),(0,aF.jsx)(su,{children:(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"OZXAKh\",defaultMessage:[{type:0,value:\"DuckDuckGo Search gives you truly private search results without tradeoffs in result quality. We have everything you’ve come to expect in an online search experience (images, maps, answers, etc.), and because there’s no search history on DuckDuckGo, you escape the filter bubble of manipulated results. You’ll also find \"},{children:[{type:0,value:\"bonus features\"}],type:8,value:\"bonusFeaturesLink\"},{type:0,value:\" that make our private search engine more convenient and a little more fun. We’re \"},{children:[{type:0,value:\"always improving\"}],type:8,value:\"alwaysImprovingLink\"},{type:0,value:\", so you can expect even more search improvements in the coming year! \"},{children:[{type:0,value:\"Learn more\"}],type:8,value:\"learnMoreLink\"}],values:{bonusFeaturesLink:sv(\"https://duckduckgo.com/bangs\"),alwaysImprovingLink:sv(\"https://duckduckgo.com/updates\"),learnMoreLink:sv(\"https://spreadprivacy.com/is-duckduckgo-a-good-search-engine/\")}})})})]}),(0,aF.jsxs)(ss,{id:\"faq-9\",children:[(0,aF.jsx)(sy,{children:(0,aF.jsx)(aH.FormattedMessage,{id:\"05khzM\",defaultMessage:[{type:0,value:\"Is DuckDuckGo owned by Google or any other entity?\"}]})}),(0,aF.jsx)(su,{children:(0,aF.jsx)(sp,{direction:\"column\",className:sh.default.faqAnswer,children:(0,aF.jsx)(nr.default,{level:\"lg\",children:(0,aF.jsx)(aH.FormattedMessage,{id:\"by494e\",defaultMessage:[{type:0,value:\"No, we are not and have never been owned by Google or any other entity. We have been an independent company since our founding in 2008. You may notice content originally from Google, such as YouTube videos, in our search results. Even though Google has a monopoly on access to this content, we are able to get it anonymously via indirect sources. This ensures we still offer quality search results without needing to rely on Google directly for any of it. We also offer an extension for Google Chrome and a Google Android app, but these are not in partnership with Google — and actually aim to protect you from Google’s online trackers. \"},{children:[{type:0,value:\"Learn more\"}],type:8,value:\"learnMoreLink\"}],values:{learnMoreLink:sv(\"https://duckduckgo.com/duckduckgo-help-pages/company/how-does-duckduckgo-protect-privacy/\")}})})})})]})]})})})]})}function sy(e){var t=e.children;return(0,aF.jsx)(sc,{children:(0,aF.jsx)(aq.default,{as:\"span\",level:6,className:sh.default.faqHeading,children:t})})}var sA=e.i(9722),sw={src:e.i(15671).default,width:1080,height:660,blurWidth:8,blurHeight:5,blurDataURL:\"data:image/png;base64,\"},sk={src:e.i(41652).default,width:1080,height:660,blurWidth:8,blurHeight:5,blurDataURL:\"data:image/png;base64,\"},s_={src:e.i(66043).default,width:1080,height:660,blurWidth:8,blurHeight:5,blurDataURL:\"data:image/png;base64,\"},sb={src:e.i(95482).default,width:1080,height:660,blurWidth:8,blurHeight:5,blurDataURL:\"data:image/png;base64,\"},sx={src:e.i(87856).default,width:1080,height:660,blurWidth:8,blurHeight:5,blurDataURL:\"data:image/png;base64,\"},sE={src:e.i(95227).default,width:1080,height:660,blurWidth:8,blurHeight:5,blurDataURL:\"data:image/png;base64,\"};function sM(){return(sM=Object.assign.bind()).apply(null,arguments)}var sC=function(e){return aV.createElement(\"svg\",sM({xmlns:\"http://www.w3.org/2000/svg\",fill:\"none\",viewBox:\"0 0 96 96\"},e),eO||(eO=aV.createElement(\"path\",{fill:\"#c19edb\",d:\"M20.081 27.168a5.167 5.167 0 0 1 5.64-5.146L71.39 26.23a5.167 5.167 0 0 1 4.692 5.145v21.8a15 15 0 0 0-2.045-.142c-8.1 0-14.667 6.567-14.667 14.667 0 1.322.176 2.603.504 3.821L25.57 73.66a5.167 5.167 0 0 1-5.489-5.156z\"})),eG||(eG=aV.createElement(\"path\",{fill:\"#682a7a\",d:\"M20.081 27.168a5.167 5.167 0 0 1 5.64-5.146L71.39 26.23a5.167 5.167 0 0 1 4.692 5.145v21.8a15 15 0 0 0-1.5-.131v-21.67a3.667 3.667 0 0 0-3.33-3.65l-45.667-4.207a3.667 3.667 0 0 0-4.003 3.65v41.338a3.667 3.667 0 0 0 3.896 3.659l34.078-2.127q.121.757.318 1.484L25.57 73.66a5.17 5.17 0 0 1-5.482-4.879l-.007-.277z\"})),eZ||(eZ=aV.createElement(\"path\",{fill:\"#7d4794\",d:\"M18.238 25.583a.355.355 0 0 1 .33.366.38.38 0 0 1-.105.247 3.4 3.4 0 0 0-.86 1.612c-.191.815-.193 1.713-.155 2.61.083 1.862.124 3.79.124 5.673a1242 1242 0 0 1-.386 30.945.4.4 0 0 1-.12.28.398.398 0 0 1-.68-.28l-.05-2